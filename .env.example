# Configurações para deploy na AWS (S3 + CloudFront)
# Renomeie este arquivo para .env ou passe como variáveis de ambiente

AWS_REGION=us-east-1
AWS_S3_BUCKET=seu-bucket-aqui
AWS_CLOUDFRONT_DISTRIBUTION_ID=E1A2B3C4D5E6F7

# Opcional: Se o bucket/CloudFront hospedar em um subdiretório (ex: relatorio-servicos/)
# Deixe em branco se o deploy for na raiz do bucket
AWS_S3_PREFIX=relatorio-servicos/

# Credenciais AWS (se não usar ~/.aws/credentials ou perfil configurado)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
